# Sao chép file này thành ".env" rồi điền giá trị thật. KHÔNG đưa ".env" lên GitHub.
# Viết sát dấu "=", không có dấu cách, không có dấu nháy.

# Địa chỉ web sản phẩm. Chạy thử trên máy: http://localhost:3001 . Chạy thật: https://enice.vn
WEB2_URL=http://localhost:3001

# Phải GIỐNG HỆT API_KEY của web sản phẩm
WEB2_KEY=

# Chỉ cần ở lần chạy đầu để tạo tài khoản duy nhất (sau đó có thể xóa 2 dòng này)
# Tên đăng nhập 3-40 ký tự không dấu; mật khẩu ít nhất 8 ký tự, có chữ và số
ADMIN_USER=
ADMIN_PASS=

PORT=3002

# Bỏ dấu # ở dòng dưới khi chạy sau nginx / hosting có HTTPS
# TRUST_PROXY=1
